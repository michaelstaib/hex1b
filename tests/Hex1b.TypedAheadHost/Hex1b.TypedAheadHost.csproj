<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Child process for TypedAheadInputTests. It must be a plain console application: the
    Microsoft.Testing.Platform test host puts the terminal into its own mode and swallows
    stdin, so keys typed ahead of a console lifetime never reach a test running inside it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hex1b\Hex1b.csproj" />
  </ItemGroup>

</Project>
